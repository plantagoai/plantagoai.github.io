# Backup settings for the Firebase project plantagoai (plantagoai.com and
# dagangilat.com). Read by backup-kit/backup.sh and .github/workflows/backup.yml.
# Names only, no secrets. Kit: github.com/micromedia-ai/yourbackupagent
KIT_REF=v1.8
PROJECT_ID=plantagoai
PROJECT_LABEL="PlantagoAI"
REPO=plantagoai/plantagoai.github.io
CI_SA=yourbackupagent-ci@plantagoai.iam.gserviceaccount.com
BACKUP_BUCKET=plantagoai-backups
BACKUP_KEEP_DAYS=14
KEEP_MIN_SETS=7
FIRESTORE_DATABASES=auto
STORAGE_BUCKETS=auto
STORAGE_MODE=full
RTDB=auto
REGIONS="us-east1 us-central1"
MANAGED_KEEP_DAYS=14
MAX_AGE_HOURS=26
VAULT_ACCOUNT=dagan.gilat@gmail.com
VAULT_PROJECT=yourbackupagent
OFFSITE_BUCKET=yourbackupagent-plantagoai
OFFSITE_KEEP_DAYS=90
ARCHIVE_BUCKET=yourbackupagent-archive
DRILL_PROJECT=yourbackupagent-drill
CHAIN_SECRETS=
DRILL_KMS_KEYS=
DRILL_WORKFLOW=rebuild-drill.yml
